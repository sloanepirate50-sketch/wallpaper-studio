<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK target gives access to the media-session API used to detect video playback. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>WallpaperStudio</RootNamespace>
    <AssemblyName>WallpaperStudio</AssemblyName>
    <!-- The WebView2 package also references its WPF control; harmless in a WinForms app. -->
    <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>

    <Version>1.0.0</Version>
    <Product>Wallpaper Studio</Product>
    <Company>Wallpaper Studio</Company>
    <Description>Animated, video and image wallpapers with playful desktop effects.</Description>
    <Copyright>© 2026</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scene template is documentation for making new scenes; it isn't shipped. -->
    <None Include="wwwroot\**\*" Exclude="wwwroot\scenes\_template.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

</Project>
